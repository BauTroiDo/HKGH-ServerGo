# =============================================================================
# HKGH Server Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file with passwords!
# =============================================================================

# -------------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------------

# Master Server Database (Login DB)
DB_LOGIN_HOST=localhost
DB_LOGIN_PORT=3306
DB_LOGIN_USER=root
DB_LOGIN_PASSWORD=change_me_to_your_password
DB_LOGIN_NAME=db_login

# Game Server Database (World DB)
DB_WORLD_HOST=localhost
DB_WORLD_PORT=3306
DB_WORLD_USER=root
DB_WORLD_PASSWORD=change_me_to_your_password
DB_WORLD_NAME=db_world

# -------------------------------------------------------------------------
# Network Configuration
# -------------------------------------------------------------------------

# MasterServer Port
MASTER_SERVER_PORT=9001

# LoginServer Port  
LOGIN_SERVER_PORT=1321

# GameServer Port
GAME_SERVER_PORT=13211

# WebShop Port
WEBSHOP_PORT=8888

# Master Server RPC Address (for LoginServer & GameServer to connect)
MASTER_SERVER_ADDRESS=127.0.0.1

# -------------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------------

# Server Name (displayed to players)
SERVER_NAME=HKGH-Production

# Max Users Per Server
MAX_USERS=100

# Script Directories
SCRIPT_DIR_LOGIN=script/login
SCRIPT_DIR_GAME=script/game

# Email Configuration
MAIL_SENDER=Sáng Tạo Ý Giang Hồ
MAIL_GREETING=Chào mừng {0} gia nhập HKGH

# -------------------------------------------------------------------------
# Client Service URLs
# -------------------------------------------------------------------------

CASH_WEB_URL=http://127.0.0.1/cashshop/shop?=
CASH_WEB_ODC_URL=http://127.0.0.1/cashshop/odc?=
CASH_WEB_CHARGE_URL=http://127.0.0.1/cashshop/charge?=
GUILD_WEB_URL=http://127.0.0.1/guild?=
SNS_URL=http://127.0.0.1/sns?=

# -------------------------------------------------------------------------
# Security Settings
# -------------------------------------------------------------------------

# Enable debug mode (set to 0 in production)
DEBUG_MODE=1

# Enable logging
LOG_LEVEL=info

# Timeout settings (in seconds)
NETWORK_TIMEOUT=30
DATABASE_TIMEOUT=10

# Rate limiting (requests per second)
RATE_LIMIT=100

# -------------------------------------------------------------------------
# Monitoring & Metrics
# -------------------------------------------------------------------------

# Enable metrics endpoint
ENABLE_METRICS=true
METRICS_PORT=9090

# Health check endpoint
HEALTH_CHECK_PATH=/health
